  "captions": [
    {"scene":"scene1","start":0.490,"end":1.620,"text":"Hello, dear viewers.","position":"bottom"},
    {"scene":"scene1","start":1.850,"end":3.360,"text":"We are from team chmod 777","position":"bottom"},
    {"scene":"scene1","start":3.360,"end":5.430,"text":"from the National Institute\nof Engineering.","position":"bottom"},
    {"scene":"scene1","start":5.930,"end":6.440,"text":"I am Vachana.","position":"bottom"},
    {"scene":"scene1","start":7.070,"end":8.820,"text":"We are discussing on\nthe problem statement","position":"bottom"},
    {"scene":"scene1","start":8.820,"end":10.480,"text":"iTantra from ISRO.","position":"bottom"},
    {"scene":"scene1","start":10.990,"end":12.800,"text":"So, it's Indian multilingual TTS","position":"bottom"},
    {"scene":"scene1","start":13.260,"end":14.510,"text":"and STT aided neural transceiver","position":"bottom"},
    {"scene":"scene1","start":14.510,"end":17.250,"text":"radio access for low bit rate\ncommunication.","position":"bottom"},
    {"scene":"scene1","start":18.020,"end":19.640,"text":"What does that actually mean?","position":"bottom"},
    {"scene":"scene1","start":19.940,"end":21.140,"text":"Our system, iTantra,","position":"bottom"},
    {"scene":"scene1","start":21.380,"end":23.250,"text":"lets two Android devices communicate","position":"bottom"},
    {"scene":"scene1","start":23.250,"end":24.780,"text":"even when there is no SIM,","position":"bottom"},
    {"scene":"scene1","start":24.920,"end":27.200,"text":"no internet, no router,\nconnections, nothing.","position":"bottom"},
    {"scene":"scene1","start":27.720,"end":29.690,"text":"Our on-device speech-to-text model","position":"bottom"},
    {"scene":"scene1","start":29.690,"end":31.430,"text":"takes the speech and converts","position":"bottom"},
    {"scene":"scene1","start":31.430,"end":33.050,"text":"the speech into compact text.","position":"bottom"},
    {"scene":"scene1","start":33.500,"end":35.870,"text":"The Bluetooth-based transport\nand relay layer","position":"bottom"},
    {"scene":"scene1","start":35.870,"end":38.850,"text":"will send this text\ninto another device.","position":"bottom"},
    {"scene":"scene1","start":39.420,"end":42.300,"text":"The text-to-speech model will again","position":"bottom"},
    {"scene":"scene1","start":42.300,"end":44.750,"text":"convert text into speech,","position":"bottom"},
    {"scene":"scene1","start":44.800,"end":46.390,"text":"which is in the message's language.","position":"bottom"},
    {"scene":"scene1","start":46.390,"end":47.400,"text":"So, in short,","position":"bottom"},
    {"scene":"scene1","start":47.840,"end":50.130,"text":"the speech becomes text\nand text is sent","position":"bottom"},
    {"scene":"scene1","start":50.560,"end":53.080,"text":"locally, and the text\nagain becomes speech.","position":"bottom"},

    {"scene":"scene2","start":7.882,"end":11.202,"text":"Hey dude, I'm in the campus\nnear the entry benches,","position":"left"},
    {"scene":"scene2","start":11.202,"end":12.462,"text":"where are you?","position":"left"},
    {"scene":"scene2","start":21.033,"end":22.533,"text":"Let's see how far\nthat message","position":"left"},
    {"scene":"scene2","start":22.533,"end":24.133,"text":"actually has to travel.","position":"left"},
    {"scene":"scene2","start":33.563,"end":36.283,"text":"Oh, it's too hot here.","position":"bottom"},
    {"scene":"scene2","start":53.463,"end":55.503,"text":"I'm in the garden.\nI'll come to you.","position":"bottom"},
    {"scene":"scene2","start":61.400,"end":63.600,"text":"But how did that happen?","position":"bottom"},
    {"scene":"scene2","start":63.600,"end":65.600,"text":"Bluetooth doesn't reach that far.","position":"bottom"},
    {"scene":"scene2","start":90.400,"end":91.800,"text":"And that's how it gets there.","position":"bottom"},
    {"scene":"scene2","start":92.700,"end":94.700,"text":"His reply comes back the same way.","position":"bottom"},

    {"scene":"scene3","start":0.300,"end":3.900,"text":"What if you need help,\nbut don't know who's nearby?","position":"bottom"},
    {"scene":"scene3","start":4.271,"end":6.871,"text":"I'm lost somewhere near\nthe construction site.","position":"left"},
    {"scene":"scene3","start":7.191,"end":7.931,"text":"Please reach me out.","position":"left"},
    {"scene":"scene3","start":8.371,"end":8.991,"text":"Help me anyone.","position":"left"},
    {"scene":"scene3","start":21.100,"end":24.300,"text":"iTantra searches nearby for help.","position":"bottom"},
    {"scene":"scene3","start":24.300,"end":27.600,"text":"If someone accepts, they can hear\nthe SOS and reply.","position":"bottom"},
    {"scene":"scene3","start":44.505,"end":44.985,"text":"Wait,","position":"bottom"},
    {"scene":"scene3","start":44.985,"end":46.065,"text":"I'm in the chemistry lab.","position":"bottom"},
    {"scene":"scene3","start":46.065,"end":47.305,"text":"I'll come get you, wait.","position":"bottom"}
  ]
